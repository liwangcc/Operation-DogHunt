# 本项目独立配置，可复制为 backend/.env。
# 地址、Key、模型名由用户提供，不读取或复制 Codex / 其他应用的凭证。
# API Key 只放在后端，不放入前端。
DOGHUNT_APP_NAME=Operation DogHunt
DOGHUNT_ENVIRONMENT=development
# 填写中转站提供的 API 根地址；程序在后面添加 /responses。
# 如果供应商要求 /v1，请将 /v1 保留在根地址中。
DOGHUNT_MODEL_BASE_URL=
DOGHUNT_MODEL_API_KEY=
DOGHUNT_MODEL_NAME=
# 思考强度默认 high（高）；可选 none/minimal/low/medium/high/xhigh，须由模型和中转站支持。
DOGHUNT_MODEL_REASONING_EFFORT=high
# 仅供应商要求额外认证头时填写；可能包含秘密，不可提交真实值。
DOGHUNT_MODEL_EXTRA_HEADERS='{}'
DOGHUNT_MODEL_TIMEOUT_SECONDS=120
DOGHUNT_MODEL_MAX_OUTPUT_TOKENS=4096
# 已有盘口脚本仍读取项目根目录 .env.local。
